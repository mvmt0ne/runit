{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "runit",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const http=require('http'),fs=require('fs'),path=require('path');const ROOT='/Users/leedongwon/Desktop/wonnyworx/runit';const T={'.html':'text/html;charset=utf-8','.js':'text/javascript','.css':'text/css','.csv':'text/csv','.svg':'image/svg+xml','.json':'application/json','.png':'image/png','.webmanifest':'application/manifest+json'};http.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/runit-home.html';const f=path.join(ROOT,u);fs.readFile(f,(e,d)=>{if(e){s.writeHead(404);s.end('not found');return;}s.writeHead(200,{'content-type':T[path.extname(f)]||'application/octet-stream'});s.end(d);});}).listen(8080,()=>console.log('listening on 8080'));"
      ],
      "port": 8080
    }
  ]
}
